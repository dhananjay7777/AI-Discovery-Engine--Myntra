# ── YouTube Data API v3 ─────────────────────────────────────────────────────
# Public comments only. Never prefix with NEXT_PUBLIC_. See docs/youtube-api-setup.md
YOUTUBE_API_KEY=

# ── Groq ────────────────────────────────────────────────────────────────────
# Get a key: https://console.groq.com/keys — steps in docs/groq-api-setup.md
# Paste into local .env. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Model ids — override here; defaults live in src/config/models.ts
GROQ_GATE_MODEL=openai/gpt-oss-20b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
GROQ_AGREEMENT_MODEL=qwen/qwen3.8-27b
# Independent TPD per model. A one-model pool is slower, not faster.
GROQ_GATE_MODEL_POOL=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-safeguard-20b,openai/gpt-oss-120b
GROQ_EXTRACT_MODEL_POOL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Rate limits — published caps on gpt-oss-20b and gpt-oss-120b (per model)
# Jobs spend at most GROQ_BUDGET_HEADROOM of each cap.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=8000
GROQ_DAILY_REQUEST_BUDGET=1000
GROQ_DAILY_TOKEN_BUDGET=200000
GROQ_BUDGET_HEADROOM=0.8

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Myntra Discovery Engine
