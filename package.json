{
  "name": "ai-discovery-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "phase0:smoke": "tsx src/scripts/phase0-smoke.ts",
    "phase0:verify-store": "tsx src/scripts/verify-store.ts",
    "test:throttle": "tsx src/scripts/test-throttle.ts",
    "phases:sync": "tsx src/scripts/sync-phase-map.ts",
    "phases:check": "tsx src/scripts/sync-phase-map.ts --check",
    "phase:start": "tsx src/scripts/set-phase-status.ts in_progress",
    "phase:complete": "tsx src/scripts/set-phase-status.ts complete",
    "phase1:collect": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs src/scripts/collect-corpus.ts",
    "phase1:balance": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs src/scripts/collect-corpus.ts --balance",
    "phase1:eval": "tsx src/scripts/phase1-eval.ts",
    "phase1:stats": "tsx src/scripts/refresh-corpus-stats.ts",
    "phase1:rebuild-dedupe": "tsx src/scripts/rebuild-dedupe.ts",
    "phase1:permalink-audit": "tsx src/scripts/generate-permalink-audit.ts",
    "phase1:migrate-layout": "tsx src/scripts/migrate-corpus-layout.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "google-play-scraper": "^10.1.3",
    "groq-sdk": "^0.37.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
